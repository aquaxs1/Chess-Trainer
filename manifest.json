{
  "manifest_version": 3,
  "name": "Chess Trainer",
  "version": "1.4.0",
  "description": "Shows the best move on any chess.com board (bots, humans, live, analysis). Stream mode puts the UI into a separate window, hidden from window-capture tools.",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "fen.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Chess Trainer"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo96.png"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ]
}