{
  "manifest_version": 3,
  "name": "Chess Trainer",
  "version": "1.1.0",
  "description": "Shows the best move on any Chess.com board (bots, live, online, analysis) as a glowing arrow. Local Stockfish.",
  "minimum_chrome_version": "109",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "fen.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}